# ---------- PostgreSQL ----------
POSTGRES_DB=erip
POSTGRES_USER=erip
POSTGRES_PASSWORD=erip
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- Django (backend) ----------
# Локальный Docker. На сервере: config.settings.prod, свой SECRET_KEY (≥32),
# свой INTERNAL_TOKEN, DJANGO_ALLOWED_HOSTS списком и пароль суперадмина не admin.
# С заготовками из этого файла prod не стартует.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
# Адрес шлюза, по которому Django отправляет оповещения
GATEWAY_URL=http://gateway:8001
# Ожидание POST /gw/v1/voice/dial. Должно быть больше GW_AMI_WAIT_SEC.
GATEWAY_DIAL_TIMEOUT=100
# Общий секрет для служебных вызовов gateway -> backend (callback статуса, журнал ошибок)
INTERNAL_TOKEN=change-me-internal
# Каталог со спецификациями полей выгрузок АИС («Примеры данных»)
AIS_SPEC_DIR=/data/ais_spec
# Сроки для manage.py purge_retained (дни). Команду ставят в планировщик.
RAW_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
ERROR_LOG_RETENTION_DAYS=90
# Суперадминистратор, создаваемый при первом запуске
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com

# ---------- FastAPI (gateway) ----------
# На сервере GW_ENVIRONMENT=prod и свой GW_INTERNAL_TOKEN (тот же, что INTERNAL_TOKEN).
GW_ENVIRONMENT=dev
GW_DATABASE_URL=postgresql+asyncpg://erip:erip@postgres:5432/erip
GW_DB_SCHEMA=gateway
GW_BACKEND_URL=http://backend:8000
GW_INTERNAL_TOKEN=change-me-internal
# Завершённые записи delivery_log старше этого срока удаляются при старте шлюза.
GW_LOG_RETENTION_DAYS=90
GW_REDIS_URL=redis://redis:6379/1
# ПРИС: тестовый контур по регламенту — http://192.168.101.81:10116
# stub — пакет собирается, в Минюст не уходит. http — вызов после itVPN, user_id и ключа.
GW_PRIS_MODE=stub
GW_PRIS_BASE_URL=http://192.168.101.81:10116
GW_PRIS_USER_ID=
GW_PRIS_ACCESS_KEY=
# Голос. stub — набор не выполняется, исход задаёт хвост номера +375.
# ami — Asterisk AMI. Хост, логин, секрет, контекст и шаблон канала даёт заказчик.
# {phone} — номер с плюсом, {digits} — только цифры. Пример шаблона: Local/{digits}@outbound
GW_VOICE_MODE=stub
GW_AMI_HOST=
GW_AMI_PORT=5038
GW_AMI_USERNAME=
GW_AMI_SECRET=
GW_AMI_CONTEXT=
GW_AMI_EXTEN=s
GW_AMI_PRIORITY=1
GW_AMI_CHANNEL=
GW_AMI_TIMEOUT_MS=30000
GW_AMI_WAIT_SEC=90
# Почта. stub — письмо не уходит. smtp — SMTP заказчика.
# 587 и STARTTLS: GW_SMTP_TLS=1. Порт 465: GW_SMTP_SSL=1 и GW_SMTP_TLS=0.
# Логин можно не задавать, если сервер пускает по адресу. Пароль нужен, только если логин задан.
# Отправитель письма — поле схемы, не эта настройка. Прочтение не запрашивается.
GW_EMAIL_MODE=stub
GW_SMTP_HOST=
GW_SMTP_PORT=587
GW_SMTP_USERNAME=
GW_SMTP_PASSWORD=
GW_SMTP_TLS=1
GW_SMTP_SSL=0
GW_SMTP_TIMEOUT=30
